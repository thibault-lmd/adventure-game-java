#BlueJ class context
comment0.target=Room
comment0.text=\r\n\ Classe\ Room\ -\ repr\u00E9sente\ une\ pi\u00E8ce\ dans\ The\ Submerged\ City.\r\n\ Chaque\ pi\u00E8ce\ a\ une\ description,\ des\ sorties\ vers\ d'autres\ pi\u00E8ces,\r\n\ une\ image\ et\ une\ liste\ d'items.\r\n\r\n\ @author\ LAM-DETRAIT\ Thibault\r\n\ @version\ 2026.04\r\n
comment1.params=pDescription\ pImage
comment1.target=Room(java.lang.String,\ java.lang.String)
comment1.text=\r\n\ Initialise\ une\ pi\u00E8ce\ avec\ sa\ description\ et\ son\ image.\r\n\ Les\ sorties\ et\ les\ items\ sont\ vides\ au\ d\u00E9part.\r\n
comment10.params=pDirection\ pClose
comment10.target=Room\ setExits(java.lang.String,\ Room)
comment10.text=\r\n\ D\u00E9finit\ une\ sortie\ depuis\ cette\ pi\u00E8ce\ dans\ la\ direction\ donn\u00E9e.\r\n
comment11.params=
comment11.target=java.lang.String\ getLongDescription()
comment11.text=\r\n\ Retourne\ une\ description\ compl\u00E8te\ de\ la\ pi\u00E8ce\ \:\r\n\ sa\ description,\ ses\ sorties\ et\ ses\ items.\r\n
comment12.params=
comment12.target=java.lang.String\ getExitString()
comment12.text=\r\n\ Retourne\ la\ liste\ des\ sorties\ disponibles\ depuis\ cette\ pi\u00E8ce.\r\n
comment13.params=
comment13.target=java.lang.String\ getImageName()
comment13.text=\r\n\ Retourne\ le\ nom\ du\ fichier\ image\ associ\u00E9\ \u00E0\ cette\ pi\u00E8ce.\r\n
comment14.params=pDoor
comment14.target=void\ addDoor(Door)
comment14.text=\r\n\ Ajoute\ une\ porte\ verrouill\u00E9e\ \u00E0\ cette\ pi\u00E8ce.\r\n
comment15.params=pRoom
comment15.target=Door\ getLockedDoor(Room)
comment15.text=\r\n\ Retourne\ la\ porte\ verrouill\u00E9e\ menant\ vers\ la\ pi\u00E8ce\ indiqu\u00E9e,\ ou\ null\ si\ aucune.\r\n
comment16.params=pKeyName
comment16.target=Door\ getLockedDoorByKey(java.lang.String)
comment16.text=\r\n\ Retourne\ la\ porte\ correspondant\ \u00E0\ la\ cl\u00E9\ donn\u00E9e,\ ou\ null\ si\ aucune.\r\n
comment17.params=pDirection
comment17.target=Room\ getExitIgnoreDoors(java.lang.String)
comment17.text=\r\n\ Retourne\ la\ pi\u00E8ce\ voisine\ sans\ v\u00E9rifier\ les\ portes\ verrouill\u00E9es.\r\n
comment2.params=pItem
comment2.target=void\ addItem(Item)
comment2.text=\r\n\ Ajoute\ un\ item\ dans\ la\ pi\u00E8ce.\r\n
comment3.params=pItemName
comment3.target=Item\ removeItem(java.lang.String)
comment3.text=\r\n\ Retire\ un\ item\ de\ la\ pi\u00E8ce\ par\ son\ nom\ et\ le\ retourne.\r\n\ Retourne\ null\ si\ l'item\ est\ introuvable.\r\n
comment4.params=
comment4.target=java.lang.String\ getItemString()
comment4.text=\r\n\ Retourne\ la\ description\ des\ items\ pr\u00E9sents\ dans\ la\ pi\u00E8ce.\r\n
comment5.params=pRoom
comment5.target=boolean\ isExit(Room)
comment5.text=\r\n\ Retourne\ true\ si\ la\ pi\u00E8ce\ pass\u00E9e\ en\ param\u00E8tre\ est\ une\ sortie\ de\ cette\ pi\u00E8ce.\r\n
comment6.params=
comment6.target=java.lang.String\ getDescription()
comment6.text=\r\n\ Retourne\ la\ description\ courte\ de\ la\ pi\u00E8ce.\r\n
comment7.params=pDirection
comment7.target=Room\ getExit(java.lang.String)
comment7.text=\r\n\ Retourne\ la\ pi\u00E8ce\ voisine\ dans\ la\ direction\ indiqu\u00E9e,\r\n\ ou\ null\ si\ aucune\ sortie\ n'existe\ dans\ cette\ direction.\r\n
comment8.params=pHasMonster
comment8.target=void\ setMonster(boolean)
comment8.text=\r\n\ D\u00E9finit\ si\ la\ pi\u00E8ce\ contient\ un\ monstre.\r\n
comment9.params=
comment9.target=boolean\ hasMonster()
comment9.text=\r\n\ Retourne\ true\ si\ la\ pi\u00E8ce\ contient\ un\ monstre.\r\n
